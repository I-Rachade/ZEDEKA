{
  "name": "mdm-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme MDM (Android / iOS) déployable sur Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "db:migrate:local": "wrangler d1 migrations apply zedeka-mdm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zedeka-mdm-db --remote",
    "typecheck": "tsc --noEmit",
    "simulate": "node agent/simulator.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
