generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tous les montants sont en FCFA (entiers).

model Restaurant {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  name              String
  phone             String
  address           String
  commissionRate    Int                    @default(10) // en pourcentage
  subscriptionFee   Int? // abonnement mensuel en FCFA (commerces inscrits via /devenir-partenaire)
  active            Boolean                @default(true)
  zone              Zone?                  @relation(fields: [zoneId], references: [id])
  zoneId            String?
  deliveryTimeMin   Int                    @default(20) // minutes
  deliveryTimeMax   Int                    @default(40)
  logoUrl           String?
  latitude          Float?
  longitude         Float?
  // Réglages gérés par le restaurant lui-même
  temporarilyClosed Boolean                @default(false)
  closedUntil       DateTime? // fermeture temporaire jusqu'à cette heure ; null = jusqu'à réouverture manuelle
  openingHours      Json                   @default("[]") // [{ day: 0-6 (0 = dimanche), open: "08:00", close: "22:00" }] ; vide = toujours ouvert
  minOrderAmount    Int                    @default(0)
  // Accès à l'espace restaurant
  ownerEmail        String?                @unique
  ownerPasswordHash String?
  sessionsValidFrom DateTime? // « se déconnecter partout » : les jetons émis avant sont refusés
  menuItems         MenuItem[]
  addons            Addon[]
  orders            Order[]
  settlements       RestaurantSettlement[]
  createdAt         DateTime               @default(now())
  vendorApplication VendorApplication?
}

model MenuItem {
  id           String        @id @default(cuid())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId String
  category     String
  name         String
  description  String?
  price        Int
  imageUrl     String?
  available    Boolean       @default(true)
  sortOrder    Int           @default(0)
  variants     MenuVariant[]
  addons       Addon[]
  orderItems   OrderItem[]

  @@index([restaurantId])
}

// Variante d'un plat (ex. « Grande portion ») : si un plat a des variantes,
// le client en choisit une et son prix remplace le prix de base.
model MenuVariant {
  id         String   @id @default(cuid())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  price      Int
  sortOrder  Int      @default(0)
}

// Supplément proposé par un restaurant (ex. « Œuf », « Piment ») et rattaché à certains plats.
model Addon {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  name         String
  price        Int
  available    Boolean    @default(true)
  menuItems    MenuItem[]
}

enum ZonePricing {
  FIXED
  DISTANCE
}

model Zone {
  id                 String              @id @default(cuid())
  name               String              @unique
  pricing            ZonePricing         @default(FIXED)
  deliveryFee        Int // tarif fixe, et tarif par défaut si la distance est inconnue
  minFee             Int?
  perKmFee           Int?
  maxFee             Int?
  active             Boolean             @default(true)
  orders             Order[]
  restaurants        Restaurant[]
  drivers            Driver[]
  rentalProviders    RentalProvider[]
  vendorApplications VendorApplication[]
  customerAddresses  CustomerAddress[]
}

enum OrderType {
  FOOD
  PARCEL
}

enum Fulfillment {
  DELIVERY
  PICKUP // le client vient chercher sa commande
}

enum OrderStatus {
  PENDING // reçue
  CONFIRMED // acceptée par le restaurant
  PREPARING // en préparation
  READY // prête, en attente du livreur
  PICKED_UP // récupérée par le livreur
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id                 String                @id @default(cuid())
  code               String                @unique // code court lisible, ex. ZD-4K7Q
  type               OrderType             @default(FOOD)
  fulfillment        Fulfillment           @default(DELIVERY)
  restaurant         Restaurant?           @relation(fields: [restaurantId], references: [id])
  restaurantId       String?
  zone               Zone                  @relation(fields: [zoneId], references: [id])
  zoneId             String
  // Client (repas) ou expéditeur (colis)
  customerName       String
  customerPhone      String
  address            String // adresse de livraison
  latitude           Float?
  longitude          Float?
  distanceKm         Float?
  note               String?
  // Colis uniquement
  pickupAddress      String?
  recipientName      String?
  recipientPhone     String?
  parcelCategory     ParcelCategory?       @relation(fields: [parcelCategoryId], references: [id])
  parcelCategoryId   String?
  weightKg           Float?
  // Montants
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus         @default(UNPAID)
  subtotal           Int
  discount           Int                   @default(0)
  deliveryFee        Int
  extraFee           Int                   @default(0) // supplément colis, etc.
  total              Int
  commission         Int                   @default(0) // part Zedeka sur le sous-total
  driverEarning      Int                   @default(0)
  cancellationFee    Int                   @default(0)
  cancellationReason String?
  refundDue          Int                   @default(0) // à rembourser au client (mobile money) après modification
  alertedAdminAt     DateTime? // commande restée sans réponse du restaurant : admin prévenu
  edits              OrderEdit[]
  status             OrderStatus           @default(PENDING)
  driver             Driver?               @relation(fields: [driverId], references: [id])
  driverId           String?
  cashCollection     CashCollection?       @relation(fields: [cashCollectionId], references: [id])
  cashCollectionId   String?
  cashCollected      Int? // espèces déclarées reçues par le livreur à la remise
  cashNote           String? // motif si le montant reçu diffère du total
  assignments        DriverAssignment[]
  driverIssues       DriverIssue[]
  locations          DriverLocation[]
  settlement         RestaurantSettlement? @relation(fields: [settlementId], references: [id])
  settlementId       String?
  items              OrderItem[]
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  createdAt          DateTime              @default(now())
  confirmedAt        DateTime?
  preparingAt        DateTime?
  prepMinutes        Int? // durée de préparation annoncée par le restaurant
  readyAt            DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?

  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId  String
  name        String // copie du nom au moment de la commande
  variantName String?
  addons      Json     @default("[]") // [{ name, price }]
  unitPrice   Int // prix unitaire, variante et suppléments compris
  quantity    Int
}

enum VehicleType {
  MOTO
  VELO
  VOITURE
}

enum DriverStatus {
  PENDING // candidature à valider
  APPROVED
  REJECTED
}

model Driver {
  id              String             @id @default(cuid())
  name            String
  phone           String             @unique
  active          Boolean            @default(true)
  status          DriverStatus       @default(APPROVED)
  online          Boolean            @default(false)
  vehicle         VehicleType        @default(MOTO)
  zone            Zone?              @relation(fields: [zoneId], references: [id])
  zoneId          String?
  orders          Order[]
  cashCollections CashCollection[]
  assignments     DriverAssignment[]
  issues          DriverIssue[]
  locations       DriverLocation[]
  lastSeenAt      DateTime? // dernier signe de vie de l'application livreur
  lastLatitude    Float?
  lastLongitude   Float?
  lastLocationAt  DateTime?
  createdAt       DateTime           @default(now())
}

enum AssignmentStatus {
  SENT // envoyée au livreur, en attente de réponse
  ACCEPTED
  REJECTED
  EXPIRED // pas de réponse dans le délai
  WITHDRAWN // retirée par la répartition
}

// Chaque affectation d'une commande à un livreur et sa réponse.
model DriverAssignment {
  id          String           @id @default(cuid())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  driver      Driver           @relation(fields: [driverId], references: [id])
  driverId    String
  status      AssignmentStatus @default(SENT)
  reason      String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([orderId, createdAt])
  @@index([driverId, status])
}

// « Un problème ? » signalé par un livreur : alerte pour la répartition.
model DriverIssue {
  id         String    @id @default(cuid())
  driver     Driver    @relation(fields: [driverId], references: [id])
  driverId   String
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  kind       String
  note       String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// Positions envoyées pendant une course.
model DriverLocation {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
}

model ParcelCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  surcharge Int     @default(0) // supplément fixe
  perKgFee  Int     @default(0) // supplément par kg
  active    Boolean @default(true)
  orders    Order[]
}

// Réglages globaux : une seule ligne (id = 1).
model Settings {
  id                      Int @id @default(1)
  parcelDriverCommission  Int @default(0) // % des frais de colis reversés au livreur (0 : livreurs salariés)
  foodDriverCommission    Int @default(0) // % des frais de livraison repas reversés au livreur
  freeCancellationMinutes Int @default(5) // annulation gratuite pendant ce délai
  cancellationFeePercent  Int @default(50) // % des frais de livraison retenus ensuite
  vendorSubscriptionFee   Int @default(15000) // abonnement mensuel des commerces partenaires (FCFA)
}

// Espèces remises par un livreur à Zedeka.
model CashCollection {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  amount    Int
  note      String?
  orders    Order[]
  createdAt DateTime @default(now())
}

// Reversement à un restaurant pour ses commandes livrées sur une période.
model RestaurantSettlement {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  periodStart  DateTime
  periodEnd    DateTime
  orderCount   Int
  orderTotal   Int // sous-totaux des commandes
  commission   Int
  amountDue    Int
  paidAt       DateTime?
  orders       Order[]
  createdAt    DateTime   @default(now())
}

// --- Location de véhicules ---

enum RentalPricing {
  HOURLY // prix à l'heure
  DAILY // prix à la journée
  DISTANCE // prix au km
}

enum TripStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

model RentalProvider {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  phone             String
  address           String
  logoUrl           String?
  active            Boolean            @default(true)
  commissionRate    Int                @default(10) // en pourcentage du prix hors taxe
  temporarilyClosed Boolean            @default(false)
  closedUntil       DateTime?
  scheduledTrips    Boolean            @default(true) // accepte les réservations pour plus tard
  pickupZone        Zone?              @relation(fields: [pickupZoneId], references: [id])
  pickupZoneId      String?
  pickupTimeMin     Int                @default(15) // délai approximatif avant prise en charge, en minutes
  pickupTimeMax     Int                @default(30)
  taxPercent        Int                @default(0)
  ownerEmail        String?            @unique
  ownerPasswordHash String?
  sessionsValidFrom DateTime?
  vehicles          Vehicle[]
  drivers           RentalDriver[]
  trips             Trip[]
  settlements       RentalSettlement[]
  createdAt         DateTime           @default(now())
}

model Vehicle {
  id              String         @id @default(cuid())
  provider        RentalProvider @relation(fields: [providerId], references: [id])
  providerId      String
  name            String
  description     String?
  imageUrl        String?
  images          Json           @default("[]") // galerie : liste de liens
  brand           String
  model           String
  category        String // ex. Berline, SUV, Minibus
  type            String // ex. Standard, Confort, Luxe
  seats           Int
  airConditioning Boolean        @default(true)
  fuel            String // Essence, Diesel, Électrique, Hybride
  transmission    String // Manuelle, Automatique
  engineCc        Int?
  powerHp         Int?
  hourlyPrice     Int? // null = pas de location à l'heure
  dailyPrice      Int?
  perKmPrice      Int?
  discountPercent Int            @default(0)
  active          Boolean        @default(true)
  units           VehicleUnit[]
  tripVehicles    TripVehicle[]
  createdAt       DateTime       @default(now())
}

model VehicleUnit {
  id           String        @id @default(cuid())
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId    String
  plateNumber  String
  vin          String?
  active       Boolean       @default(true)
  tripVehicles TripVehicle[]

  @@unique([vehicleId, plateNumber])
}

model RentalDriver {
  id         String         @id @default(cuid())
  provider   RentalProvider @relation(fields: [providerId], references: [id])
  providerId String
  firstName  String
  lastName   String
  phone      String
  email      String?
  photoUrl   String?
  idType     String? // CNI, passeport, permis
  idNumber   String?
  idImageUrl String?
  active     Boolean        @default(true)
  trips      Trip[]
  createdAt  DateTime       @default(now())
}

model Trip {
  id                 String            @id @default(cuid())
  code               String            @unique // ex. ZL-4K7Q
  provider           RentalProvider    @relation(fields: [providerId], references: [id])
  providerId         String
  status             TripStatus        @default(PENDING)
  pricing            RentalPricing
  scheduledAt        DateTime? // null = départ immédiat
  duration           Int // heures, jours ou km selon le tarif
  customerName       String
  customerPhone      String
  customerEmail      String?
  pickupAddress      String
  pickupLatitude     Float?
  pickupLongitude    Float?
  destinationAddress String
  destLatitude       Float?
  destLongitude      Float?
  note               String?
  driver             RentalDriver?     @relation(fields: [driverId], references: [id])
  driverId           String?
  vehicles           TripVehicle[]
  fare               Int // somme des prix des véhicules avant remise
  discount           Int               @default(0) // remise véhicule + remise manuelle
  extraDiscount      Int               @default(0) // remise manuelle du loueur (incluse dans discount)
  extraFee           Int               @default(0)
  tax                Int               @default(0)
  total              Int
  commission         Int               @default(0)
  paymentMethod      PaymentMethod     @default(CASH)
  paymentStatus      PaymentStatus     @default(UNPAID)
  cancellationReason String?
  alertedAdminAt     DateTime?
  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  settlement         RentalSettlement? @relation(fields: [settlementId], references: [id])
  settlementId       String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  createdAt          DateTime          @default(now())

  @@index([customerId, createdAt])
}

model TripVehicle {
  id        String       @id @default(cuid())
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  vehicleId String
  unit      VehicleUnit? @relation(fields: [unitId], references: [id])
  unitId    String?
  name      String
  unitPrice Int
  quantity  Int
  duration  Int
  discount  Int          @default(0)
  price     Int // unitPrice × quantity × duration, avant remise
}

model RentalSettlement {
  id          String         @id @default(cuid())
  provider    RentalProvider @relation(fields: [providerId], references: [id])
  providerId  String
  periodStart DateTime
  periodEnd   DateTime
  tripCount   Int
  tripTotal   Int // totaux TTC des courses
  commission  Int
  amountDue   Int
  paidAt      DateTime?
  trips       Trip[]
  createdAt   DateTime       @default(now())
}

// Candidature d'un commerce partenaire (formulaire /devenir-partenaire).
// Une fois validée par l'équipe, elle donne lieu à un Restaurant.

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MomoOperator {
  TMONEY
  FLOOZ
}

enum VendorPlan {
  COMMISSION
  SUBSCRIPTION
}

model VendorApplication {
  id              String                  @id @default(cuid())
  reference       String                  @unique // ex. ZP-7KQ2M
  status          VendorApplicationStatus @default(PENDING)
  businessName    String
  businessType    String
  zone            Zone                    @relation(fields: [zoneId], references: [id])
  zoneId          String
  address         String
  latitude        Float?
  longitude       Float?
  deliveryTimeMin Int // minutes
  deliveryTimeMax Int
  logoPath        String
  coverPath       String
  ownerFirstName  String
  ownerLastName   String
  phone           String // +228XXXXXXXX
  whatsapp        String?
  momoOperator    MomoOperator
  momoNumber      String
  rccm            String?
  nif             String?
  legalDocPath    String?
  email           String // en minuscules
  passwordHash    String
  plan            VendorPlan
  monthlyFee      Int? // prix de l'abonnement affiché au moment de la candidature (FCFA/mois)
  termsAcceptedAt DateTime
  createdAt       DateTime                @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  restaurant      Restaurant?             @relation(fields: [restaurantId], references: [id])
  restaurantId    String?                 @unique // restaurant créé à la validation

  @@index([status, createdAt])
  @@index([email])
}

// ─── Clients de l'application ───────────────────────────────────────────────────

// Compte client identifié par son numéro (connexion par code à usage unique).
// La suppression du compte l'anonymise : les commandes restent pour la comptabilité.
model Customer {
  id          String            @id @default(cuid())
  phone       String            @unique // +228XXXXXXXX, ou « supprime:<id> » après suppression
  name        String?
  addresses   CustomerAddress[]
  orders      Order[]
  trips       Trip[]
  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String // Maison, Bureau…
  quarter    String // quartier
  landmark   String // repère : portail bleu, en face de la pharmacie…
  latitude   Float?
  longitude  Float?
  zone       Zone     @relation(fields: [zoneId], references: [id])
  zoneId     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Panels partenaires : alertes, modifications, accès ─────────────────────────

// Modification d'une commande par le restaurant (article manquant…), visible par le client.
model OrderEdit {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  reason    String
  changes   Json // [{ name, from, to, replacement? }]
  oldTotal  Int
  newTotal  Int
  refund    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Abonnement Web Push d'un navigateur, pour un rôle (admin, restaurant, rental) et un sujet (id).
model PushSubscription {
  id        String   @id @default(cuid())
  role      String
  subject   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([role, subject])
}

// Code de réinitialisation du mot de passe d'un partenaire (15 minutes).
model PasswordReset {
  id         String    @id @default(cuid())
  role       String
  subject    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([role, subject, createdAt])
}
