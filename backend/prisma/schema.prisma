generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tous les montants sont en FCFA (entiers).

model Restaurant {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  phone          String
  address        String
  commissionRate Int        @default(10) // en pourcentage
  active         Boolean    @default(true)
  menuItems      MenuItem[]
  orders         Order[]
  createdAt      DateTime   @default(now())
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  restaurantId String
  category     String
  name         String
  description  String?
  price        Int
  available    Boolean     @default(true)
  sortOrder    Int         @default(0)
  orderItems   OrderItem[]

  @@index([restaurantId])
}

model Zone {
  id          String  @id @default(cuid())
  name        String  @unique
  deliveryFee Int
  active      Boolean @default(true)
  orders      Order[]
}

enum OrderStatus {
  PENDING    // reçue
  CONFIRMED  // acceptée par le restaurant
  PICKED_UP  // récupérée par le livreur
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique // code court lisible, ex. ZD-4K7Q
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  zone          Zone          @relation(fields: [zoneId], references: [id])
  zoneId        String
  customerName  String
  customerPhone String
  address       String
  note          String?
  paymentMethod PaymentMethod
  subtotal      Int
  deliveryFee   Int
  total         Int
  status        OrderStatus   @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  name       String   // copie du nom au moment de la commande
  unitPrice  Int
  quantity   Int
}
