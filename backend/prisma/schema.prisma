generator client {
  provider   = "prisma-client-js"
  // Sans moteur Rust : plus léger sur Cloudflare Workers.
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  // Avec D1 (src/db.ts), cette adresse ne sert qu'aux commandes Prisma en local.
  url      = "file:./local.db"
}

// Tous les montants sont en FCFA (entiers).

model Restaurant {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  name              String
  phone             String
  address           String
  commissionRate    Int                    @default(0) // en pourcentage (0 : le commerce paie un abonnement)
  subscriptionFee   Int? // abonnement mensuel en FCFA
  active            Boolean                @default(true)
  zone              Zone?                  @relation(fields: [zoneId], references: [id])
  zoneId            String?
  deliveryTimeMin   Int                    @default(20) // minutes
  deliveryTimeMax   Int                    @default(40)
  logoUrl           String?
  latitude          Float?
  longitude         Float?
  // Réglages gérés par le restaurant lui-même
  temporarilyClosed Boolean                @default(false)
  closedUntil       DateTime? // fermeture temporaire jusqu'à cette heure ; null = jusqu'à réouverture manuelle
  openingHours      Json                   @default("[]") // [{ day: 0-6 (0 = dimanche), open: "08:00", close: "22:00" }] ; vide = toujours ouvert
  minOrderAmount    Int                    @default(0)
  // Accès à l'espace restaurant
  ownerEmail        String?                @unique
  ownerPasswordHash String?
  sessionsValidFrom DateTime? // « se déconnecter partout » : les jetons émis avant sont refusés
  menuItems         MenuItem[]
  addons            Addon[]
  orders            Order[]
  settlements       RestaurantSettlement[]
  supportRequests   SupportRequest[]
  deposits          RestaurantDeposit[]
  tables            RestaurantTable[]
  createdAt         DateTime               @default(now())
  vendorApplication VendorApplication?
  locationRequest   LocationRequest? // position demandée au gérant par un lien
}

// Table numérotée d'un restaurant : son QR code ouvre la carte, la commande arrive avec le numéro de la table.
// token : partie aléatoire du lien du QR code (le numéro seul serait trop facile à deviner).
model RestaurantTable {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  number       Int
  token        String     @unique
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, number])
}

model MenuItem {
  id           String        @id @default(cuid())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId String
  category     String
  name         String
  description  String?
  price        Int
  imageUrl     String?
  available    Boolean       @default(true)
  sortOrder    Int           @default(0)
  variants     MenuVariant[]
  addons       Addon[]
  orderItems   OrderItem[]

  @@index([restaurantId])
}

// Variante d'un plat (ex. « Grande portion ») : si un plat a des variantes,
// le client en choisit une et son prix remplace le prix de base.
model MenuVariant {
  id         String   @id @default(cuid())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  price      Int
  sortOrder  Int      @default(0)
}

// Supplément proposé par un restaurant (ex. « Œuf », « Piment ») et rattaché à certains plats.
model Addon {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  name         String
  price        Int
  available    Boolean    @default(true)
  menuItems    MenuItem[]
}

enum ZonePricing {
  FIXED
  DISTANCE
}

model Zone {
  id                 String              @id @default(cuid())
  name               String              @unique
  pricing            ZonePricing         @default(FIXED)
  deliveryFee        Int // ancien tarif de zone, plus utilisé : repas et colis sont facturés au km (réglages)
  minFee             Int?
  perKmFee           Int?
  maxFee             Int?
  latitude           Float? // centre de la zone : la zone d'un colis est celle dont le centre est le plus proche
  longitude          Float?
  active             Boolean             @default(true)
  orders             Order[]
  restaurants        Restaurant[]
  drivers            Driver[]
  vendorApplications VendorApplication[]
  customerAddresses  CustomerAddress[]
}

enum OrderType {
  FOOD
  PARCEL
}

enum Fulfillment {
  DELIVERY
  PICKUP // le client vient chercher sa commande
}

enum OrderStatus {
  PENDING // reçue
  CONFIRMED // acceptée par le restaurant
  PREPARING // en préparation
  READY // prête, en attente du livreur
  PICKED_UP // récupérée par le livreur
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id                 String                @id @default(cuid())
  code               String                @unique // code court lisible, ex. ZD-4K7Q
  type               OrderType             @default(FOOD)
  fulfillment        Fulfillment           @default(DELIVERY)
  restaurant         Restaurant?           @relation(fields: [restaurantId], references: [id])
  restaurantId       String?
  zone               Zone                  @relation(fields: [zoneId], references: [id])
  zoneId             String
  // Client (repas) ou expéditeur (colis)
  customerName       String
  customerPhone      String
  address            String // adresse de livraison
  latitude           Float?
  longitude          Float?
  distanceKm         Float?
  note               String?
  // Colis uniquement
  pickupAddress      String?
  pickupLatitude     Float? // position du retrait, donnée par l'expéditeur
  pickupLongitude    Float?
  payer              String                @default("SENDER") // colis : SENDER (expéditeur) ou RECIPIENT (destinataire à la livraison)
  locationSource     String? // origine de latitude/longitude : SENDER ou RECIPIENT (lien envoyé au destinataire)
  locationRequest    LocationRequest?
  recipientName      String?
  recipientPhone     String?
  parcelCategory     ParcelCategory?       @relation(fields: [parcelCategoryId], references: [id])
  parcelCategoryId   String?
  weightKg           Float?
  parcelSize         String? // SMALL, MEDIUM ou LARGE (classe de taille choisie par l'expéditeur)
  // Montants
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus         @default(UNPAID)
  subtotal           Int
  discount           Int                   @default(0)
  deliveryFee        Int
  extraFee           Int                   @default(0) // supplément colis, etc.
  total              Int
  commission         Int                   @default(0) // part Zedeka sur le sous-total
  driverEarning      Int                   @default(0)
  cancellationFee    Int                   @default(0)
  cancellationReason String?
  refundDue          Int                   @default(0) // à rembourser au client (mobile money) après modification
  alertedAdminAt     DateTime? // commande restée sans réponse du restaurant : admin prévenu
  edits              OrderEdit[]
  status             OrderStatus           @default(PENDING)
  driver             Driver?               @relation(fields: [driverId], references: [id])
  driverId           String?
  cashCollection     CashCollection?       @relation(fields: [cashCollectionId], references: [id])
  cashCollectionId   String?
  cashCollected      Int? // espèces déclarées reçues par le livreur à la remise
  cashNote           String? // motif si le montant reçu diffère du total
  assignments        DriverAssignment[]
  driverIssues       DriverIssue[]
  supportRequests    SupportRequest[]
  locations          DriverLocation[]
  settlement         RestaurantSettlement? @relation(fields: [settlementId], references: [id])
  settlementId       String?
  // Repas payé à Zedeka et réglé sur le dépôt du restaurant (au lieu d'un relevé) : fixé à la livraison.
  paidFromDeposit    Boolean               @default(false)
  // Commande sur place, passée depuis le QR code d'une table (fulfillment PICKUP, sans livreur) : numéro copié.
  tableNumber        Int?
  items              OrderItem[]
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  // Conditions et confidentialité acceptées à la commande (case obligatoire, refusée par l'API sans elle).
  termsAcceptedAt    DateTime?
  createdAt          DateTime              @default(now())
  confirmedAt        DateTime?
  preparingAt        DateTime?
  prepMinutes        Int? // durée de préparation annoncée par le restaurant
  readyAt            DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  // Clôture par le client : le livreur déclare la remise, le client confirme (ou donne le code au livreur).
  handedOverAt       DateTime? // remise déclarée par le livreur, en attente du client
  deliveryCode       String? // 4 chiffres montrés au client, à donner au livreur pour clôturer sur place
  closedBy           String? // CUSTOMER, CODE, AUTO (sans réponse), ADMIN, DRIVER (anciennes commandes)
  receiptDisputedAt  DateTime? // le client dit ne pas avoir reçu
  receiptDisputeNote String?
  // Notes du client (1 à 5) : livreur obligatoire à la clôture, restaurant facultatif.
  driverRating       Int?
  restaurantRating   Int?
  ratingComment      String?
  ratedAt            DateTime?

  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId  String
  name        String // copie du nom au moment de la commande
  variantName String?
  addons      Json     @default("[]") // [{ name, price }]
  unitPrice   Int // prix unitaire, variante et suppléments compris
  quantity    Int
}

// Indépendant : payé à la course, peut refuser une offre. Salarié : salaire fixe, les courses lui sont attribuées.
enum DriverEmployment {
  FREELANCE
  STAFF
}

enum VehicleType {
  MOTO
  VELO
  VOITURE
}

enum DriverStatus {
  PENDING // candidature à valider
  APPROVED
  REJECTED
}

model Driver {
  id              String             @id @default(cuid())
  name            String
  phone           String             @unique
  // Facultatif : pour se connecter aussi avec l'e-mail et le PIN, et recevoir un code si le PIN est oublié.
  email           String?            @unique
  active          Boolean            @default(true)
  status          DriverStatus       @default(APPROVED)
  online          Boolean            @default(false)
  vehicle         VehicleType        @default(MOTO)
  employment      DriverEmployment   @default(FREELANCE)
  monthlySalary   Int? // salaire mensuel en FCFA des livreurs salariés de Zedeka
  zone            Zone?              @relation(fields: [zoneId], references: [id])
  zoneId          String?
  orders          Order[]
  cashCollections CashCollection[]
  assignments     DriverAssignment[]
  issues          DriverIssue[]
  locations       DriverLocation[]
  lastSeenAt      DateTime? // dernier signe de vie de l'application livreur
  lastLatitude    Float?
  lastLongitude   Float?
  lastLocationAt  DateTime?
  // Jetons émis avant cette date refusés (suspension, numéro changé, « tous les appareils »).
  sessionsValidFrom DateTime?
  // Code PIN à 4 chiffres (haché), comme les clients : choisi à la candidature, ou donné par le directeur.
  pinHash         String?
  pinAttempts     Int                @default(0)
  pinLockedUntil  DateTime?
  // Après un code SMS vérifié : nouveau PIN sans l'ancien pendant quelques minutes.
  pinResetUntil   DateTime?
  // Supprimé depuis l'admin alors qu'il avait des courses : compte fermé, coordonnées effacées, nom gardé pour l'historique.
  deletedAt       DateTime?
  // Conditions livreurs et confidentialité acceptées à la candidature.
  termsAcceptedAt DateTime?
  createdAt       DateTime           @default(now())
}

enum AssignmentStatus {
  SENT // envoyée au livreur, en attente de réponse
  ACCEPTED
  REJECTED
  EXPIRED // pas de réponse dans le délai
  WITHDRAWN // retirée par la répartition
}

// Chaque affectation d'une commande à un livreur et sa réponse.
model DriverAssignment {
  id          String           @id @default(cuid())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  driver      Driver           @relation(fields: [driverId], references: [id])
  driverId    String
  status      AssignmentStatus @default(SENT)
  reason      String?
  assignedBy  String? // nom du membre de l'équipe qui a attribué la course
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([orderId, createdAt])
  @@index([driverId, status])
}

// « Un problème ? » signalé par un livreur : alerte pour la répartition.
model DriverIssue {
  id         String    @id @default(cuid())
  driver     Driver    @relation(fields: [driverId], references: [id])
  driverId   String
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  kind       String
  note       String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// Positions envoyées pendant une course.
model DriverLocation {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
}

model ParcelCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  surcharge Int     @default(0) // supplément fixe
  perKgFee  Int     @default(0) // supplément par kg
  active    Boolean @default(true)
  orders    Order[]
}

// Réglages globaux : une seule ligne (id = 1).
// Membres de l'équipe Zedeka qui se connectent à l'admin. Le directeur voit tout ; le dispatcheur gère
// les commandes, la répartition et la disponibilité des livreurs, sans finances ni réglages.
model TeamMember {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         TeamRole  @default(DISPATCHER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

enum TeamRole {
  DIRECTOR
  DEPUTY // administrateur adjoint : tout sauf l'équipe (lecture seule), les réglages, les zones, les tarifs et les finances
  MANAGER // managerin : commandes, répartition, demandes des clients et partenaires ; ni finances ni réglages
  DISPATCHER
}

model Settings {
  id                      Int     @id @default(1)
  parcelDriverCommission  Int     @default(0) // % des frais de colis reversés au livreur (0 : livreurs salariés)
  foodDriverCommission    Int     @default(0) // % des frais de livraison repas reversés au livreur
  freeCancellationMinutes Int     @default(5) // annulation gratuite pendant ce délai
  cancellationFeePercent  Int     @default(50) // % des frais de livraison retenus ensuite
  vendorSubscriptionFee   Int     @default(15000) // abonnement mensuel des commerces partenaires (FCFA)
  parcelMinFee            Int     @default(1000) // colis : prix de livraison minimum (FCFA)
  parcelPerKmFee          Int     @default(200) // colis : prix par km entre le retrait et la livraison
  parcelMaxFee            Int     @default(0) // colis : prix maximum, 0 pour aucun plafond
  foodMinFee              Int     @default(500) // repas : prix de livraison minimum (FCFA), position du client connue
  foodPerKmFee            Int     @default(150) // repas : prix par km entre le restaurant et le point de livraison (moins cher que les colis)
  foodMaxFee              Int     @default(0) // repas : prix maximum, 0 pour aucun plafond
  mobileMoneyEnabled      Boolean @default(false) // paiement mobile money proposé aux clients
  depositAmount           Int     @default(25000) // somme laissée par Zedeka chez chaque restaurant (FCFA)
  depositLowThreshold     Int     @default(5000) // alerte « dépôt bas » sous ce solde (FCFA)
  autoDispatchEnabled     Boolean @default(false) // attribution automatique des courses au livreur en ligne le plus proche
  autoDispatchMaxTries    Int     @default(3) // propositions automatiques par commande avant de laisser la main à l'équipe
}

// Espèces remises par un livreur à Zedeka.
model CashCollection {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  amount    Int
  note      String?
  orders    Order[]
  createdAt DateTime @default(now())
}

// Reversement à un restaurant pour ses commandes livrées sur une période.
model RestaurantSettlement {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  periodStart  DateTime
  periodEnd    DateTime
  orderCount   Int
  orderTotal   Int // sous-totaux des commandes
  commission   Int
  amountDue    Int
  paidAt       DateTime?
  orders       Order[]
  createdAt    DateTime   @default(now())
}

// Argent laissé par Zedeka chez un restaurant. Le restaurant se paie dessus les plats des commandes livrées et
// payées à Zedeka (espèces du livreur, mobile money) ; Zedeka recharge. Montant négatif : correction (motif).
// Solde = somme des dépôts − plats des commandes « paidFromDeposit ». Ce n'est pas l'argent des clients.
model RestaurantDeposit {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  amount       Int
  note         String?
  createdBy    String? // nom du membre de l'équipe
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// Candidature d'un commerce partenaire (formulaire /devenir-partenaire).
// Une fois validée par l'équipe, elle donne lieu à un Restaurant.

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MomoOperator {
  TMONEY
  FLOOZ
}

enum VendorPlan {
  COMMISSION
  SUBSCRIPTION
}

model VendorApplication {
  id              String                  @id @default(cuid())
  reference       String                  @unique // ex. ZP-7KQ2M
  status          VendorApplicationStatus @default(PENDING)
  businessName    String
  businessType    String
  zone            Zone                    @relation(fields: [zoneId], references: [id])
  zoneId          String
  address         String
  latitude        Float?
  longitude       Float?
  deliveryTimeMin Int // minutes
  deliveryTimeMax Int
  logoPath        String
  coverPath       String
  ownerFirstName  String
  ownerLastName   String
  phone           String // +228XXXXXXXX
  whatsapp        String?
  momoOperator    MomoOperator
  momoNumber      String
  rccm            String?
  nif             String?
  legalDocPath    String?
  email           String // en minuscules
  passwordHash    String
  plan            VendorPlan
  monthlyFee      Int? // prix de l'abonnement affiché au moment de la candidature (FCFA/mois)
  termsAcceptedAt DateTime
  createdAt       DateTime                @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  restaurant      Restaurant?             @relation(fields: [restaurantId], references: [id])
  restaurantId    String?                 @unique // restaurant créé à la validation

  @@index([status, createdAt])
  @@index([email])
}

// ─── Clients de l'application ───────────────────────────────────────────────────

// Compte client identifié par son numéro (connexion par code à usage unique).
// La suppression du compte l'anonymise : les commandes restent pour la comptabilité.
model Customer {
  id          String            @id @default(cuid())
  phone       String            @unique // +228XXXXXXXX, ou « supprime:<id> » après suppression
  name        String?
  // Connexion par e-mail et code PIN (4 chiffres, haché). Le code SMS ne sert plus qu'à l'inscription et au PIN oublié.
  email          String?   @unique
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?
  // Après un code SMS ou e-mail vérifié : le PIN peut être choisi sans l'ancien jusqu'à cette heure.
  pinResetUntil  DateTime?
  addresses   CustomerAddress[]
  orders      Order[]
  lastLoginAt DateTime?
  deletedAt   DateTime?
  // Jetons émis avant cette date refusés (« se déconnecter de tous les appareils »).
  sessionsValidFrom DateTime?
  // Conditions et confidentialité acceptées à la création du compte.
  termsAcceptedAt DateTime?
  createdAt   DateTime          @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String // Maison, Bureau…
  quarter    String // quartier
  landmark   String // repère : portail bleu, en face de la pharmacie…
  latitude   Float?
  longitude  Float?
  zone       Zone     @relation(fields: [zoneId], references: [id])
  zoneId     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Panels partenaires : alertes, modifications, accès ─────────────────────────

// Modification d'une commande par le restaurant (article manquant…), visible par le client.
model OrderEdit {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  reason    String
  changes   Json // [{ name, from, to, replacement? }]
  oldTotal  Int
  newTotal  Int
  refund    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Abonnement Web Push d'un navigateur, pour un rôle (admin, restaurant, rental) et un sujet (id).
model PushSubscription {
  id        String   @id @default(cuid())
  role      String
  subject   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([role, subject])
}

// Fil des notifications de l'équipe (admin, dispatch…) : chaque événement utile (commande, restaurant, livreur,
// candidature, espèces) y est écrit, puis envoyé en pop-up aux navigateurs abonnés. Gardé 30 jours.
model StaffNotification {
  id        String   @id @default(cuid())
  category  String // ORDERS, RESTAURANTS, DRIVERS, APPLICATIONS, FINANCE (voir staffAlerts.ts)
  title     String
  body      String
  url       String
  alarm     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([createdAt])
}

// Réglages de notification d'un membre de l'équipe (sujet = id du membre, ou « admin » pour ADMIN_PASSWORD) :
// catégories coupées et heure de la dernière lecture du fil.
model StaffNotificationPrefs {
  subject   String   @id
  muted     String   @default("[]") // catégories sans pop-up ni son, en JSON
  seenAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Code de réinitialisation du mot de passe d'un partenaire (15 minutes).
model PasswordReset {
  id         String    @id @default(cuid())
  role       String
  subject    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([role, subject, createdAt])
}

// Demande de position envoyée au destinataire d'un colis. Le lien porte un jeton aléatoire dont seule
// l'empreinte est gardée ; la position reçue est écrite dans Order.latitude/longitude.
model LocationRequest {
  id            String    @id @default(cuid())
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String?   @unique // vide tant que l'expéditeur n'a pas validé sa commande
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId  String?     @unique // position du restaurant demandée à son gérant (sans commande)
  tokenHash     String    @unique
  pollKeyHash   String?   @unique // clé gardée par l'expéditeur pour suivre la réponse avant la commande
  senderName    String?
  recipientName String?
  status        String    @default("PENDING") // PENDING, OPENED, SHARED, DECLINED, EXPIRED, REVOKED
  kind          String    @default("PARCEL") // PARCEL (colis), FOOD (repas livré à quelqu'un d'autre) ou RESTAURANT (position du restaurant)
  expiresAt     DateTime
  openedAt      DateTime?
  consentAt     DateTime? // accord donné par le destinataire avant l'envoi de sa position
  respondedAt   DateTime?
  latitude      Float? // position reçue, gardée ici jusqu'à la commande
  longitude     Float?
  accuracyM     Float? // précision annoncée par le téléphone, en mètres
  landmark      String? // repère écrit par le destinataire
  createdAt     DateTime  @default(now())

  @@index([status, expiresAt])
}

// Demande reçue ou passée par l'équipe (appel, WhatsApp) : client, restaurant, boutique ou livreur.
// File commune des managerins : chacune peut prendre une demande, la noter et la clore.
model SupportRequest {
  id           String               @id @default(cuid())
  source       String // CUSTOMER, RESTAURANT, DRIVER ou OTHER
  channel      String // WHATSAPP_CALL, WHATSAPP_MESSAGE, PHONE_CALL ou OTHER
  direction    String               @default("IN") // IN : reçue ; OUT : appel ou message de l'équipe (réclamation, rappel)
  subject      String
  details      String?
  contactName  String?
  contactPhone String?
  status       String               @default("OPEN") // OPEN, IN_PROGRESS, DONE
  priority     String               @default("NORMAL") // NORMAL ou URGENT
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  restaurantId String?
  createdBy    String // nom du membre qui l'a saisie
  assignedTo   String? // nom du membre qui s'en occupe
  notes        SupportRequestNote[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  closedAt     DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([restaurantId])
}

// Suivi d'une demande : ce qui a été dit ou fait, par qui.
model SupportRequestNote {
  id        String         @id @default(cuid())
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    String
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId, createdAt])
}
