generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tous les montants sont en FCFA (entiers).

model Restaurant {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  phone          String
  address        String
  commissionRate Int        @default(10) // en pourcentage
  active         Boolean    @default(true)
  menuItems      MenuItem[]
  orders         Order[]
  createdAt      DateTime   @default(now())
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  restaurantId String
  category     String
  name         String
  description  String?
  price        Int
  available    Boolean     @default(true)
  sortOrder    Int         @default(0)
  orderItems   OrderItem[]

  @@index([restaurantId])
}

model Zone {
  id                 String              @id @default(cuid())
  name               String              @unique
  deliveryFee        Int
  active             Boolean             @default(true)
  orders             Order[]
  vendorApplications VendorApplication[]
}

enum OrderStatus {
  PENDING // reçue
  CONFIRMED // acceptée par le restaurant
  PICKED_UP // récupérée par le livreur
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique // code court lisible, ex. ZD-4K7Q
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  zone          Zone          @relation(fields: [zoneId], references: [id])
  zoneId        String
  customerName  String
  customerPhone String
  address       String
  note          String?
  paymentMethod PaymentMethod
  subtotal      Int
  deliveryFee   Int
  total         Int
  status        OrderStatus   @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime      @default(now())

  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  name       String // copie du nom au moment de la commande
  unitPrice  Int
  quantity   Int
}

// Candidature d'un commerce partenaire (formulaire /devenir-partenaire).
// Une fois validée par l'équipe, elle donne lieu à un Restaurant.

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MomoOperator {
  TMONEY
  FLOOZ
}

enum VendorPlan {
  COMMISSION
  SUBSCRIPTION
}

model VendorApplication {
  id              String                  @id @default(cuid())
  reference       String                  @unique // ex. ZP-7KQ2M
  status          VendorApplicationStatus @default(PENDING)
  businessName    String
  businessType    String
  zone            Zone                    @relation(fields: [zoneId], references: [id])
  zoneId          String
  address         String
  latitude        Float?
  longitude       Float?
  deliveryTimeMin Int // minutes
  deliveryTimeMax Int
  logoPath        String
  coverPath       String
  ownerFirstName  String
  ownerLastName   String
  phone           String // +228XXXXXXXX
  whatsapp        String?
  momoOperator    MomoOperator
  momoNumber      String
  rccm            String?
  nif             String?
  legalDocPath    String?
  email           String // en minuscules
  passwordHash    String
  plan            VendorPlan
  termsAcceptedAt DateTime
  createdAt       DateTime                @default(now())
  reviewedAt      DateTime?

  @@index([status, createdAt])
  @@index([email])
}
