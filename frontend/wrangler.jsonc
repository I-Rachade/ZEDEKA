// Site Zedeka (Next.js via OpenNext) sur zedeka.poinderecharge.com.
// Les appels /api/* partent vers le Worker zedeka-api par une liaison de service : l'API n'a pas d'adresse publique.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zedeka-web",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "zedeka.poinderecharge.com", "custom_domain": true }],
  // Photos des plats rangées avec le site : passent d'abord par worker.ts, qui sert la version WebP aux navigateurs
  // qui la comprennent (environ 30 % plus légère), le JPEG aux autres.
  // html_handling et not_found_handling à « none » : un fichier de public/ n'est servi qu'à son chemin exact, comme avec
  // Next.js, sans contourner le middleware (exigé par OpenNext depuis la 1.20.15).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/photos-plats/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "zedeka-web" },
    { "binding": "API", "service": "zedeka-api" }
  ],
  "observability": { "enabled": true }
}
