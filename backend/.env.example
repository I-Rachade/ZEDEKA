DATABASE_URL="postgresql://zedeka:zedeka@localhost:5432/zedeka"
PORT=4000
# Origine du frontend autorisée (CORS)
FRONTEND_ORIGIN="http://localhost:3000"
# Numéro WhatsApp de Zedeka qui reçoit les commandes (format international, sans +)
ZEDEKA_WHATSAPP="22890000000"
# Espace admin : mot de passe du directeur des opérations et clé secrète des jetons
ADMIN_PASSWORD="changer-moi"
ADMIN_SECRET="une-longue-chaine-aleatoire"

# Dossier des fichiers envoyés (logos, documents des partenaires)
UPLOAD_DIR="uploads"

# Codes de connexion des clients : tant qu'aucun fournisseur SMS/WhatsApp n'est branché, l'API renvoie
# le code dans la réponse (affiché à l'écran). Activé par défaut hors production ; à mettre à false en production.
OTP_DEV_CODES="true"

# Notifications Web Push (alarmes des partenaires). Générer avec : npx web-push generate-vapid-keys
# Sans ces variables, des clés sont créées au premier démarrage et gardées dans vapid.json.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:contact@zedeka.tg"
