<?xml version="1.0" encoding="utf-8"?>
<!-- Le jeton de l'appareil ne quitte jamais le téléphone : ni sauvegarde cloud, ni transfert vers un autre appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
