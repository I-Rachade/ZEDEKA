# Copier en .dev.vars pour le développement local (jamais commité), puis remplir chaque valeur.
# JWT_SECRET : 48 octets aléatoires   -> node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DATA_KEY   : 32 octets en base64    -> node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
DATA_KEY=
# Jeton de première installation (POST /api/setup)
SETUP_TOKEN=
# Jeton partagé avec le contrôleur Wi-Fi (en-tête X-Network-Token)
NETWORK_TOKEN=
# Optionnel : Android Management API (Google)
# AMA_ENTERPRISE=enterprises/LC0xxxxxxx
# AMA_SERVICE_ACCOUNT={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# Optionnel : Apple MDM (APNs) — voir docs
# APPLE_MDM_TOPIC=com.apple.mgmt.External.xxxxxxxx
# Secret partagé avec le back-office Zedeka (= MDM_SSO_SECRET de zedeka-api), au moins 32 caractères
SSO_SECRET=
