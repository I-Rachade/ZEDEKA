generator client {
  provider   = "prisma-client-js"
  // Sans moteur Rust : plus léger sur Cloudflare Workers.
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  // Avec D1 (src/db.ts), cette adresse ne sert qu'aux commandes Prisma en local.
  url      = "file:./local.db"
}

// Tous les montants sont en FCFA (entiers).

model Restaurant {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  name              String
  phone             String
  address           String
  commissionRate    Int                    @default(0) // en pourcentage (0 : le commerce paie un abonnement)
  subscriptionFee   Int? // abonnement mensuel en FCFA
  active            Boolean                @default(true)
  zone              Zone?                  @relation(fields: [zoneId], references: [id])
  zoneId            String?
  deliveryTimeMin   Int                    @default(20) // minutes
  deliveryTimeMax   Int                    @default(40)
  logoUrl           String?
  latitude          Float?
  longitude         Float?
  // Réglages gérés par le restaurant lui-même
  temporarilyClosed Boolean                @default(false)
  closedUntil       DateTime? // fermeture temporaire jusqu'à cette heure ; null = jusqu'à réouverture manuelle
  openingHours      Json                   @default("[]") // [{ day: 0-6 (0 = dimanche), open: "08:00", close: "22:00" }] ; vide = toujours ouvert
  minOrderAmount    Int                    @default(0)
  // Accès à l'espace restaurant
  ownerEmail        String?                @unique
  ownerPasswordHash String?
  sessionsValidFrom DateTime? // « se déconnecter partout » : les jetons émis avant sont refusés
  deletedAt         DateTime? // supprimé depuis l'admin : masqué partout, gardé pour l'historique des commandes
  menuItems         MenuItem[]
  addons            Addon[]
  promos            Promo[]
  orders            Order[]
  settlements       RestaurantSettlement[]
  supportRequests   SupportRequest[]
  deposits          RestaurantDeposit[]
  tables            RestaurantTable[]
  tableCallsEnabled Boolean                @default(true) // sonnerie de table (appel serveur, addition)
  tableCalls        TableCall[]
  staff             RestaurantStaff[]
  createdAt         DateTime               @default(now())
  vendorApplication VendorApplication?
  locationRequest   LocationRequest? // position demandée au gérant par un lien
}

// Équipe d'un restaurant : comptes créés par le gérant (propriétaire du compte) ou une manageuse.
// CASHIER (caissière) : commandes reçues et en cours, encaissement au comptoir, messages au livreur.
// MANAGER (manageuse) : comme le gérant, sauf l'identité du restaurant (nom, numéro, adresse, logo),
// son mot de passe et les comptes des autres manageuses. Voir restaurantTeam.ts.
model RestaurantStaff {
  id                String              @id @default(cuid())
  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId      String
  name              String
  email             String              @unique
  passwordHash      String
  role              RestaurantStaffRole @default(CASHIER)
  active            Boolean             @default(true)
  lastLoginAt       DateTime?
  sessionsValidFrom DateTime? // jetons émis avant refusés (mot de passe changé, compte désactivé)
  createdAt         DateTime            @default(now())

  @@index([restaurantId])
}

enum RestaurantStaffRole {
  MANAGER
  CASHIER
}

// Table numérotée d'un restaurant : son QR code ouvre la carte, la commande arrive avec le numéro de la table.
// token : partie aléatoire du lien du QR code (le numéro seul serait trop facile à deviner).
model RestaurantTable {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  number       Int
  token        String     @unique
  createdAt    DateTime   @default(now())
  calls        TableCall[]

  @@unique([restaurantId, number])
}

// Sonnerie de table : appel du client assis (serveur, addition, autre). Voir tableCalls.ts.
model TableCall {
  id           String          @id @default(cuid())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId      String
  tableNumber  Int
  kind         String          @default("WAITER") // WAITER | BILL | OTHER
  payment      String? // addition : CASH | MOBILE_MONEY
  note         String?
  status       String          @default("OPEN") // OPEN | ACK (« J'arrive ») | DONE | EXPIRED
  rungAt       DateTime        @default(now()) // dernière sonnerie (appel ou nouvel appui du client)
  remindedAt   DateTime? // relance envoyée pour cette sonnerie
  ackAt        DateTime?
  ackBy        String?
  doneAt       DateTime?
  createdAt    DateTime        @default(now())

  @@index([restaurantId, status])
  @@index([tableId, status])
}

model MenuItem {
  id           String        @id @default(cuid())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId String
  category     String
  name         String
  description  String?
  price        Int
  imageUrl     String?
  available    Boolean       @default(true)
  sortOrder    Int           @default(0)
  variants     MenuVariant[]
  addons       Addon[]
  orderItems   OrderItem[]

  @@index([restaurantId])
}

// Variante d'un plat (ex. « Grande portion ») : si un plat a des variantes,
// le client en choisit une et son prix remplace le prix de base.
model MenuVariant {
  id         String   @id @default(cuid())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  price      Int
  sortOrder  Int      @default(0)

  @@index([menuItemId])
}

// Supplément proposé par un restaurant (ex. « Œuf », « Piment ») et rattaché à certains plats.
model Addon {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  name         String
  price        Int
  available    Boolean    @default(true)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

enum ZonePricing {
  FIXED
  DISTANCE
}

model Zone {
  id                 String              @id @default(cuid())
  name               String              @unique
  pricing            ZonePricing         @default(FIXED)
  deliveryFee        Int // prix fixe de la zone, appliqué quand les réglages facturent la livraison par zone
  minFee             Int?
  perKmFee           Int?
  maxFee             Int?
  latitude           Float? // centre de la zone : la zone d'un colis est celle dont le centre est le plus proche
  longitude          Float?
  active             Boolean             @default(true)
  orders             Order[]
  restaurants        Restaurant[]
  drivers            Driver[]
  vendorApplications VendorApplication[]
  customerAddresses  CustomerAddress[]
}

enum OrderType {
  FOOD
  PARCEL
}

enum Fulfillment {
  DELIVERY
  PICKUP // le client vient chercher sa commande
}

enum OrderStatus {
  PENDING // reçue
  CONFIRMED // acceptée par le restaurant
  PREPARING // en préparation
  READY // prête, en attente du livreur
  PICKED_UP // récupérée par le livreur
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id                 String                @id @default(cuid())
  code               String                @unique // code court lisible, ex. ZD-4K7Q
  type               OrderType             @default(FOOD)
  fulfillment        Fulfillment           @default(DELIVERY)
  restaurant         Restaurant?           @relation(fields: [restaurantId], references: [id])
  restaurantId       String?
  zone               Zone                  @relation(fields: [zoneId], references: [id])
  zoneId             String
  // Client (repas) ou expéditeur (colis)
  customerName       String
  customerPhone      String
  address            String // adresse de livraison
  latitude           Float?
  longitude          Float?
  distanceKm         Float?
  note               String?
  // Colis uniquement
  pickupAddress      String?
  pickupLatitude     Float? // position du retrait, donnée par l'expéditeur
  pickupLongitude    Float?
  pickupAt           DateTime? // retrait programmé par l'expéditeur ; null : dès que possible
  payer              String                @default("SENDER") // colis : SENDER (expéditeur) ou RECIPIENT (destinataire à la livraison)
  locationSource     String? // origine de latitude/longitude : SENDER ou RECIPIENT (lien envoyé au destinataire)
  locationRequest    LocationRequest?
  recipientName      String?
  recipientPhone     String?
  parcelCategory     ParcelCategory?       @relation(fields: [parcelCategoryId], references: [id])
  parcelCategoryId   String?
  weightKg           Float?
  parcelSize         String? // SMALL, MEDIUM ou LARGE (classe de taille choisie par l'expéditeur)
  // Montants
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus         @default(UNPAID)
  counterPaidBy      String? // qui a encaissé au comptoir du restaurant (gérant, manageuse ou caissière)
  counterPaidAt      DateTime?
  subtotal           Int
  discount           Int                   @default(0)
  promoId            String?
  promo              Promo?                @relation(fields: [promoId], references: [id], onDelete: SetNull)
  promoCode          String? // code saisi à la caisse, gardé même si la promotion est supprimée
  promoPayer         String? // ZEDEKA ou RESTAURANT : qui paie la remise du code promo
  restaurantMessage   String? // dernier message rapide du restaurant au livreur
  restaurantMessageAt DateTime?
  confirmedBy         String? // nom de la personne du restaurant qui a accepté
  confirmedByRole     String? // OWNER, MANAGER ou CASHIER
  clientKey           String?   @unique // clé anti-doublon de l'envoi différé (hors ligne)
  deliveryFee        Int
  extraFee           Int                   @default(0) // supplément colis, etc.
  total              Int
  commission         Int                   @default(0) // part Zedeka sur le sous-total
  driverEarning      Int                   @default(0)
  cancellationFee    Int                   @default(0)
  cancellationReason String?
  refundDue          Int                   @default(0) // à rembourser au client (mobile money) après modification
  alertedAdminAt     DateTime? // commande restée sans réponse du restaurant : admin prévenu
  edits              OrderEdit[]
  status             OrderStatus           @default(PENDING)
  driver             Driver?               @relation(fields: [driverId], references: [id])
  driverId           String?
  cashCollection     CashCollection?       @relation(fields: [cashCollectionId], references: [id])
  cashCollectionId   String?
  cashCollected      Int? // espèces déclarées reçues par le livreur à la remise
  cashNote           String? // motif si le montant reçu diffère du total
  assignments        DriverAssignment[]
  driverIssues       DriverIssue[]
  supportRequests    SupportRequest[]
  locations          DriverLocation[]
  settlement         RestaurantSettlement? @relation(fields: [settlementId], references: [id])
  settlementId       String?
  // Repas payé à Zedeka et réglé sur le dépôt du restaurant (au lieu d'un relevé) : fixé à la livraison.
  paidFromDeposit    Boolean               @default(false)
  paidByDriver       Boolean               @default(false) // livreur indépendant qui a payé les plats au restaurant sur place
  // Commande sur place, passée depuis le QR code d'une table (fulfillment PICKUP, sans livreur) : numéro copié.
  tableNumber        Int?
  items              OrderItem[]
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId         String?
  // Conditions et confidentialité acceptées à la commande (case obligatoire, refusée par l'API sans elle).
  termsAcceptedAt    DateTime?
  createdAt          DateTime              @default(now())
  confirmedAt        DateTime?
  preparingAt        DateTime?
  prepMinutes        Int? // durée de préparation annoncée par le restaurant
  readyAt            DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  // Clôture par le client : le livreur déclare la remise, le client confirme (ou donne le code au livreur).
  handedOverAt       DateTime? // remise déclarée par le livreur, en attente du client
  deliveryCode       String? // 4 chiffres montrés au client, à donner au livreur pour clôturer sur place
  closedBy           String? // CUSTOMER, CODE, AUTO (sans réponse), ADMIN, DRIVER (anciennes commandes)
  receiptDisputedAt  DateTime? // le client dit ne pas avoir reçu
  receiptDisputeNote String?
  receiptKeyHash     String? // commande sans compte : empreinte de la clé gardée sur l'appareil qui a commandé
  // Colis d'un marchand e-commerce : contre-remboursement (codAmount, prix des articles encaissé par le livreur
  // et reversé au marchand), référence de sa boutique, et reversement qui l'a réglé.
  merchant           Merchant?             @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  merchantId         String?
  codAmount          Int                   @default(0)
  merchantRef        String?
  merchantPayout     MerchantPayout?       @relation(fields: [merchantPayoutId], references: [id], onDelete: SetNull)
  merchantPayoutId   String?
  // Notes du client (1 à 5) : livreur obligatoire à la clôture, restaurant facultatif.
  driverRating       Int?
  restaurantRating   Int?
  ratingComment      String?
  ratedAt            DateTime?

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([driverId, status])
  @@index([settlementId])
  @@index([cashCollectionId])
  @@index([merchantId, createdAt])
  @@index([merchantPayoutId])
  @@index([promoId])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId  String
  name        String // copie du nom au moment de la commande
  variantName String?
  addons      Json     @default("[]") // [{ name, price }]
  unitPrice   Int // prix unitaire, variante et suppléments compris
  quantity    Int

  @@index([orderId])
}

// Indépendant : payé à la course, peut refuser une offre. Salarié : salaire fixe, les courses lui sont attribuées.
enum DriverEmployment {
  FREELANCE
  STAFF
}

enum VehicleType {
  MOTO
  VELO
  VOITURE
}

enum DriverStatus {
  PENDING // candidature à valider
  APPROVED
  REJECTED
}

model Driver {
  id                String             @id @default(cuid())
  name              String
  phone             String             @unique
  // Facultatif : pour se connecter aussi avec l'e-mail et le PIN, et recevoir un code si le PIN est oublié.
  email             String?            @unique
  active            Boolean            @default(true)
  status            DriverStatus       @default(APPROVED)
  online            Boolean            @default(false)
  vehicle           VehicleType        @default(MOTO)
  employment        DriverEmployment   @default(FREELANCE)
  monthlySalary     Int? // salaire mensuel en FCFA des livreurs salariés de Zedeka
  zone              Zone?              @relation(fields: [zoneId], references: [id])
  zoneId            String?
  orders            Order[]
  cashCollections   CashCollection[]
  assignments       DriverAssignment[]
  issues            DriverIssue[]
  locations         DriverLocation[]
  lastSeenAt        DateTime? // dernier signe de vie de l'application livreur
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  // Jetons émis avant cette date refusés (suspension, numéro changé, « tous les appareils »).
  sessionsValidFrom DateTime?
  // Code PIN à 4 chiffres (haché), comme les clients : choisi à la candidature, ou donné par le directeur.
  pinHash           String?
  pinAttempts       Int                @default(0)
  pinLockedUntil    DateTime?
  // Après un code SMS vérifié : nouveau PIN sans l'ancien pendant quelques minutes.
  pinResetUntil     DateTime?
  // Supprimé depuis l'admin alors qu'il avait des courses : compte fermé, coordonnées effacées, nom gardé pour l'historique.
  deletedAt         DateTime?
  // Conditions livreurs et confidentialité acceptées à la candidature.
  termsAcceptedAt   DateTime?
  createdAt         DateTime           @default(now())
  // Mode Zed (moto-taxi). deliveries : faux pour un conducteur Zed inscrit seul (pas de livraisons).
  deliveries        Boolean            @default(true)
  zedStatus         String? // PENDING, ACTIVE, REJECTED, SUSPENDED ; null : pas inscrit
  zedAvailable      Boolean            @default(false) // « Disponible pour les Zed »
  plate             String?
  zedAppliedAt      DateTime?
  zedReviewedAt     DateTime?
  zedReviewedBy     String?
  zedNote           String?
  zedMissed         Int                @default(0) // propositions laissées sans réponse d'affilée
  zedDocuments      ZedDocument[]
  zedPayments       ZedPayment[]
  zedRides          ZedRide[]
  zedOffers         ZedOffer[]
  // Services faits par ce livreur ou prestataire : codes séparés par des virgules (« ERRAND,GAS »).
  serviceCodes      String             @default("")
  serviceRequests   ServiceRequest[]
  // Salarié de Zedeka : moto du parc prise pour son service (une à la fois), et l'historique des prises.
  motorbike         Motorbike?
  motorbikeShifts   MotorbikeShift[]
}

enum AssignmentStatus {
  SENT // envoyée au livreur, en attente de réponse
  ACCEPTED
  REJECTED
  EXPIRED // pas de réponse dans le délai
  WITHDRAWN // retirée par la répartition
}

// Chaque affectation d'une commande à un livreur et sa réponse.
model DriverAssignment {
  id          String           @id @default(cuid())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  driver      Driver           @relation(fields: [driverId], references: [id])
  driverId    String
  status      AssignmentStatus @default(SENT)
  reason      String?
  assignedBy  String? // nom du membre de l'équipe qui a attribué la course
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([orderId, createdAt])
  @@index([driverId, status])
}

// « Un problème ? » signalé par un livreur : alerte pour la répartition.
model DriverIssue {
  id         String    @id @default(cuid())
  driver     Driver    @relation(fields: [driverId], references: [id])
  driverId   String
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  kind       String
  note       String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// Positions envoyées pendant une course.
model DriverLocation {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
  @@index([orderId])
}

model ParcelCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  surcharge Int     @default(0) // supplément fixe
  perKgFee  Int     @default(0) // supplément par kg
  active    Boolean @default(true)
  orders    Order[]
}

// Publicités de l'accueil de l'appli client (carrousel sous « Livrer à »), gérées dans l'admin.
model Ad {
  id        String    @id @default(cuid())
  title     String // texte de remplacement de l'image, et nom dans l'admin
  imageUrl  String
  linkUrl   String? // ouvert au toucher : page de l'appli (/app/...) ou lien https://
  position  Int       @default(0) // ordre d'affichage, du plus petit au plus grand
  active    Boolean   @default(true)
  startsAt  DateTime? // affichée à partir de cette date (facultatif)
  endsAt    DateTime? // plus affichée après cette date (facultatif)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, position])
}

// Réglages globaux : une seule ligne (id = 1).
// Membres de l'équipe Zedeka qui se connectent à l'admin. Le directeur voit tout ; le dispatcheur gère
// les commandes, la répartition et la disponibilité des livreurs, sans finances ni réglages.
model TeamMember {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         TeamRole  @default(DISPATCHER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

enum TeamRole {
  DIRECTOR
  DEPUTY // administrateur adjoint : tout sauf l'équipe (lecture seule), les réglages, les zones, les tarifs et les finances
  MANAGER // managerin : commandes, répartition, demandes des clients et partenaires ; ni finances ni réglages
  DISPATCHER
}

model Settings {
  id                      Int     @id @default(1)
  parcelDriverCommission  Int     @default(0) // % des frais de colis reversés au livreur (0 : livreurs salariés)
  foodDriverCommission    Int     @default(0) // % des frais de livraison repas reversés au livreur
  freeCancellationMinutes Int     @default(5) // annulation gratuite pendant ce délai
  cancellationFeePercent  Int     @default(50) // % des frais de livraison retenus ensuite
  vendorSubscriptionFee   Int     @default(15000) // abonnement mensuel des commerces partenaires (FCFA)
  parcelMinFee            Int     @default(1000) // colis : prix de livraison minimum (FCFA)
  parcelPerKmFee          Int     @default(200) // colis : prix par km entre le retrait et la livraison
  parcelMaxFee            Int     @default(0) // colis : prix maximum, 0 pour aucun plafond
  foodMinFee              Int     @default(500) // repas : prix de livraison minimum (FCFA), position du client connue
  foodPerKmFee            Int     @default(150) // repas : prix par km entre le restaurant et le point de livraison (moins cher que les colis)
  foodMaxFee              Int     @default(0) // repas : prix maximum, 0 pour aucun plafond
  foodPricingMode         String  @default("KM") // repas : KM (tarif au km) ou ZONE (prix fixe de la zone de livraison)
  parcelPricingMode       String  @default("KM") // colis : KM (tarif au km) ou ZONE (prix fixe de la zone de livraison)
  mobileMoneyEnabled      Boolean @default(false) // paiement mobile money proposé aux clients
  depositAmount           Int     @default(25000) // somme laissée par Zedeka chez chaque restaurant (FCFA)
  depositLowThreshold     Int     @default(5000) // alerte « dépôt bas » sous ce solde (FCFA)
  autoDispatchEnabled     Boolean @default(false) // attribution automatique des courses au livreur en ligne le plus proche
  autoDispatchMaxTries    Int     @default(3) // propositions automatiques par commande avant de laisser la main à l'équipe
  zedEnabled              Boolean @default(false) // appel d'un Zed proposé aux clients
  zedRadiusM              Int     @default(1000) // rayon de recherche des conducteurs Zed (m)
  zedOfferSeconds         Int     @default(15) // délai pour accepter une alerte Zed
  zedMaxOffers            Int     @default(5) // conducteurs alertés l'un après l'autre avant « aucun Zed »
  zedFarRadiusM           Int     @default(5000) // « Demander une course » (aucun Zed proche, ou course programmée) : rayon élargi (m)
  zedMinFee               Int     @default(300) // course demandée : prix minimum (FCFA)
  zedPerKmFee             Int     @default(150) // course demandée : prix par km de l'itinéraire (FCFA)
  zedMonthPrice           Int     @default(15000) // plan Zed au mois (FCFA, 30 jours)
  zedDayPrice             Int     @default(500) // plan Zed à la journée (FCFA)
  zedTrialDays            Int     @default(30) // essai offert à la validation du dossier
  zedPaymentNumber        String  @default("") // numéro mobile money de Zedeka pour payer le plan
  zedButtonColor          String  @default("SUN") // bouton Zed de l'appli client : SUN, GREEN, CORAL ou INK
}

// Espèces remises par un livreur à Zedeka.
model CashCollection {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id])
  driverId  String
  amount    Int
  note      String?
  orders    Order[]
  createdAt DateTime @default(now())
}

// Reversement à un restaurant pour ses commandes livrées sur une période.
model RestaurantSettlement {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  periodStart  DateTime
  periodEnd    DateTime
  orderCount   Int
  orderTotal   Int // sous-totaux des commandes
  commission   Int
  amountDue    Int
  paidAt       DateTime?
  orders       Order[]
  createdAt    DateTime   @default(now())
}

// Argent laissé par Zedeka chez un restaurant. Le restaurant se paie dessus les plats des commandes livrées et
// payées à Zedeka (espèces du livreur, mobile money) ; Zedeka recharge. Montant négatif : correction (motif).
// Solde = somme des dépôts − plats des commandes « paidFromDeposit ». Ce n'est pas l'argent des clients.
model RestaurantDeposit {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  amount       Int
  note         String?
  createdBy    String? // nom du membre de l'équipe
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// Candidature d'un commerce partenaire (formulaire /devenir-partenaire).
// Une fois validée par l'équipe, elle donne lieu à un Restaurant.

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MomoOperator {
  TMONEY
  FLOOZ
}

enum VendorPlan {
  COMMISSION
  SUBSCRIPTION
}

model VendorApplication {
  id              String                  @id @default(cuid())
  reference       String                  @unique // ex. ZP-7KQ2M
  status          VendorApplicationStatus @default(PENDING)
  businessName    String
  businessType    String
  zone            Zone                    @relation(fields: [zoneId], references: [id])
  zoneId          String
  address         String
  latitude        Float?
  longitude       Float?
  deliveryTimeMin Int // minutes
  deliveryTimeMax Int
  logoPath        String
  coverPath       String
  ownerFirstName  String
  ownerLastName   String
  phone           String // +228XXXXXXXX
  whatsapp        String?
  momoOperator    MomoOperator
  momoNumber      String
  rccm            String?
  nif             String?
  legalDocPath    String?
  email           String // en minuscules
  passwordHash    String
  plan            VendorPlan
  monthlyFee      Int? // prix de l'abonnement affiché au moment de la candidature (FCFA/mois)
  termsAcceptedAt DateTime
  createdAt       DateTime                @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  restaurant      Restaurant?             @relation(fields: [restaurantId], references: [id])
  restaurantId    String?                 @unique // restaurant créé à la validation

  @@index([status, createdAt])
  @@index([email])
}

// ─── Clients de l'application ───────────────────────────────────────────────────

// Compte client identifié par son numéro (connexion par code à usage unique).
// La suppression du compte l'anonymise : les commandes restent pour la comptabilité.
model Customer {
  id                String            @id @default(cuid())
  phone             String            @unique // +228XXXXXXXX, ou « supprime:<id> » après suppression
  name              String?
  // Connexion par e-mail et code PIN (4 chiffres, haché). Le code SMS ne sert plus qu'à l'inscription et au PIN oublié.
  email             String?           @unique
  pinHash           String?
  pinAttempts       Int               @default(0)
  pinLockedUntil    DateTime?
  // Après un code SMS ou e-mail vérifié : le PIN peut être choisi sans l'ancien jusqu'à cette heure.
  pinResetUntil     DateTime?
  addresses         CustomerAddress[]
  orders            Order[]
  lastLoginAt       DateTime?
  deletedAt         DateTime?
  // Jetons émis avant cette date refusés (« se déconnecter de tous les appareils »).
  sessionsValidFrom DateTime?
  // Conditions et confidentialité acceptées à la création du compte.
  termsAcceptedAt   DateTime?
  createdAt         DateTime          @default(now())
  zedRides          ZedRide[]
  merchant          Merchant?
  serviceRequests   ServiceRequest[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String // Maison, Bureau…
  quarter    String // quartier
  landmark   String // repère : portail bleu, en face de la pharmacie…
  latitude   Float?
  longitude  Float?
  zone       Zone     @relation(fields: [zoneId], references: [id])
  zoneId     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Panels partenaires : alertes, modifications, accès ─────────────────────────

// Modification d'une commande par le restaurant (article manquant…), visible par le client.
model OrderEdit {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  reason    String
  changes   Json // [{ name, from, to, replacement? }]
  oldTotal  Int
  newTotal  Int
  refund    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Abonnement Web Push d'un navigateur, pour un rôle (admin, restaurant, rental) et un sujet (id).
model PushSubscription {
  id        String   @id @default(cuid())
  role      String
  subject   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([role, subject])
}

// Fil des notifications de l'équipe (admin, dispatch…) : chaque événement utile (commande, restaurant, livreur,
// candidature, espèces) y est écrit, puis envoyé en pop-up aux navigateurs abonnés. Gardé 30 jours.
model StaffNotification {
  id        String   @id @default(cuid())
  category  String // ORDERS, RESTAURANTS, DRIVERS, APPLICATIONS, FINANCE (voir staffAlerts.ts)
  title     String
  body      String
  url       String
  alarm     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([createdAt])
}

// Réglages de notification d'un membre de l'équipe (sujet = id du membre, ou « admin » pour ADMIN_PASSWORD) :
// catégories coupées et heure de la dernière lecture du fil.
model StaffNotificationPrefs {
  subject   String   @id
  muted     String   @default("[]") // catégories sans pop-up ni son, en JSON
  seenAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Code de réinitialisation du mot de passe d'un partenaire (15 minutes).
model PasswordReset {
  id         String    @id @default(cuid())
  role       String
  subject    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([role, subject, createdAt])
}

// Demande de position envoyée au destinataire d'un colis. Le lien porte un jeton aléatoire dont seule
// l'empreinte est gardée ; la position reçue est écrite dans Order.latitude/longitude.
model LocationRequest {
  id            String      @id @default(cuid())
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String?     @unique // vide tant que l'expéditeur n'a pas validé sa commande
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId  String?     @unique // position du restaurant demandée à son gérant (sans commande)
  tokenHash     String      @unique
  pollKeyHash   String?     @unique // clé gardée par l'expéditeur pour suivre la réponse avant la commande
  senderName    String?
  recipientName String?
  status        String      @default("PENDING") // PENDING, OPENED, SHARED, DECLINED, EXPIRED, REVOKED
  kind          String      @default("PARCEL") // PARCEL (colis), FOOD (repas livré à quelqu'un d'autre) ou RESTAURANT (position du restaurant)
  expiresAt     DateTime
  openedAt      DateTime?
  consentAt     DateTime? // accord donné par le destinataire avant l'envoi de sa position
  respondedAt   DateTime?
  latitude      Float? // position reçue, gardée ici jusqu'à la commande
  longitude     Float?
  accuracyM     Float? // précision annoncée par le téléphone, en mètres
  landmark      String? // repère écrit par le destinataire
  createdAt     DateTime    @default(now())

  @@index([status, expiresAt])
}

// Demande reçue ou passée par l'équipe (appel, WhatsApp) : client, restaurant, boutique ou livreur.
// File commune des managerins : chacune peut prendre une demande, la noter et la clore.
model SupportRequest {
  id           String               @id @default(cuid())
  source       String // CUSTOMER, RESTAURANT, DRIVER ou OTHER
  channel      String // WHATSAPP_CALL, WHATSAPP_MESSAGE, PHONE_CALL ou OTHER
  direction    String               @default("IN") // IN : reçue ; OUT : appel ou message de l'équipe (réclamation, rappel)
  subject      String
  details      String?
  contactName  String?
  contactPhone String?
  status       String               @default("OPEN") // OPEN, IN_PROGRESS, DONE
  priority     String               @default("NORMAL") // NORMAL ou URGENT
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  restaurantId String?
  createdBy    String // nom du membre qui l'a saisie
  assignedTo   String? // nom du membre qui s'en occupe
  notes        SupportRequestNote[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  closedAt     DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([restaurantId])
}

// Suivi d'une demande : ce qui a été dit ou fait, par qui.
model SupportRequestNote {
  id        String         @id @default(cuid())
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    String
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId, createdAt])
}

// --- Mode Zed (moto-taxi) ---

// Photos du dossier d'un conducteur Zed (R2, servies seulement à l'admin) : SELFIE, ID_CARD, LICENCE, MOTO.
model ZedDocument {
  id        String   @id @default(cuid())
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId  String
  kind      String
  fileKey   String
  createdAt DateTime @default(now())

  @@unique([driverId, kind])
}

// Paiement du plan Zed. plan : TRIAL, MONTH, DAY ; method : TRIAL, FLOOZ, TMONEY, CASH ;
// status : PENDING (référence à vérifier), CONFIRMED (période ouverte), REJECTED.
model ZedPayment {
  id         String    @id @default(cuid())
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId   String
  plan       String
  days       Int
  amount     Int
  method     String
  reference  String?   @unique
  status     String    @default("PENDING")
  startsAt   DateTime?
  endsAt     DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([driverId, status])
  @@index([status, createdAt])
}

// Course Zed : SEARCHING → ACCEPTED → ONBOARD → COMPLETED, ou NO_DRIVER, ou CANCELLED (CUSTOMER, DRIVER, SYSTEM).
model ZedRide {
  id            String     @id @default(cuid())
  code          String     @unique
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  latitude      Float
  longitude     Float
  accuracy      Float?
  landmark      String?
  destination   String? // facultative, écrite par le client
  // CALL : « Appeler un Zed » (Zed proche, prix sur place) ; REQUEST : « Demander une course » (destination
  // obligatoire, rayon élargi, prix de l'itinéraire donné avant l'arrivée du Zed).
  mode                 String  @default("CALL")
  destinationLatitude  Float?
  destinationLongitude Float?
  distanceM            Int? // longueur de l'itinéraire départ → destination
  quotedPrice          Int? // prix annoncé au client avant l'arrivée du Zed (FCFA)
  scheduledFor  DateTime? // course réservée à l'avance (statut SCHEDULED jusqu'à 15 min avant)
  status        String     @default("SEARCHING")
  driver        Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId      String?
  acceptedAt    DateTime?
  onboardAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
  price         Int? // prix fait sur place, noté par le conducteur (facultatif)
  rating        Int? // note du client, 1 à 5
  ratingComment String?
  createdAt     DateTime   @default(now())
  offers        ZedOffer[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([driverId, status])
  @@index([status, scheduledFor])
}

// Alerte Zed envoyée à un conducteur : SENT, ACCEPTED, DECLINED, EXPIRED, CANCELLED.
model ZedOffer {
  id          String    @id @default(cuid())
  ride        ZedRide   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rideId      String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId    String
  rank        Int
  distanceM   Int
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  @@index([rideId])
  @@index([driverId, status])
  @@index([status, sentAt])
}

// Code promo (back-office, page Promotions) : remise en pourcentage (plafonnée), montant fixe ou livraison offerte,
// sur tous les restaurants ou un seul, payée par Zedeka ou par le restaurant. « Afficher sur l'accueil » le met
// dans la rangée « Offres pour vous » avec un bouton « Activer ».
model Promo {
  id           String      @id @default(cuid())
  code         String      @unique
  title        String? // titre de la carte de l'accueil, ex. « -20 % sur toute la commande »
  kind         String // PERCENT, AMOUNT ou FREE_DELIVERY
  value        Int         @default(0) // pourcentage ou montant en FCFA
  maxDiscount  Int? // plafond de la remise en pourcentage
  minSubtotal  Int         @default(0)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payer        String      @default("ZEDEKA") // ZEDEKA ou RESTAURANT
  startsAt     DateTime?
  endsAt       DateTime?
  maxUses      Int?
  perCustomer  Int         @default(1)
  showOnHome   Boolean     @default(false)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  orders       Order[]

  @@index([active])
}

// ─── Marchands e-commerce : boutiques qui envoient surtout des colis ─────────────

// Profil marchand ajouté à un compte client (même connexion : numéro ou e-mail et PIN). Point de ramassage,
// jours et heure du ramassage habituel, numéro mobile money pour les reversements du contre-remboursement.
model Merchant {
  id                String           @id @default(cuid())
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId        String           @unique
  shopName          String
  phone             String
  pickupAddress     String
  pickupLatitude    Float?
  pickupLongitude   Float?
  pickupDays        String           @default("") // jours du ramassage habituel : « 1,3,5 » (0 = dimanche)
  pickupTime        String? // « 10:00 »
  payoutPhone       String? // mobile money pour les reversements
  active            Boolean          @default(true) // suspendu par l'équipe : plus d'envois
  pickupRequestedAt DateTime? // dernier « Venez ramasser » envoyé à l'équipe
  createdAt         DateTime         @default(now())
  orders            Order[]
  payouts           MerchantPayout[]
}

// Reversement au marchand : contre-remboursements encaissés moins les frais de livraison qu'il paie.
model MerchantPayout {
  id         String   @id @default(cuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId String
  amount     Int
  orderCount Int      @default(0)
  note       String?
  paidBy     String?
  createdAt  DateTime @default(now())
  orders     Order[]

  @@index([merchantId, createdAt])
}

// Module du bouton « Services » (src/services.ts) : état choisi dans l'admin (ON, SOON, OFF) et ordre d'affichage.
// Sans ligne, le module prend son état par défaut défini dans le code.
model ServiceModule {
  code      String   @id
  state     String   @default("OFF")
  sortOrder Int      @default(0)
  // Tarif choisi par le directeur (FCFA) ; null : tarif par défaut du code.
  basePrice Int?
  unitPrice Int?
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

// Demande de service (courses, gaz et eau, lessive, ménage, dépannage) : PENDING → ACCEPTED → ON_THE_WAY →
// IN_PROGRESS → DONE, ou CANCELLED (CUSTOMER, PROVIDER, STAFF). Le prestataire est un livreur qui a ce service dans
// son profil. Prix : estimation à la demande (base + unité × quantité), plus les achats ou pièces notés à la fin.
model ServiceRequest {
  id            String    @id @default(cuid())
  code          String    @unique
  module        String
  status        String    @default("PENDING")
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  address       String
  latitude      Float?
  longitude     Float?
  details       String    @default("{}") // JSON propre au service (liste, quantité, heures, problème)
  summary       String // résumé lisible, ex. « 2 bouteilles de gaz 12 kg »
  note          String?
  scheduledFor  DateTime? // créneau choisi ; null : dès que possible
  estimate      Int
  extra         Int? // achats, produits ou pièces payés par le prestataire, notés à la fin
  finalPrice    Int?
  provider      Driver?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId    String?
  acceptedAt    DateTime?
  onTheWayAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
  rating        Int?
  ratingComment String?
  createdAt     DateTime  @default(now())

  @@index([status, module, createdAt])
  @@index([customerId, createdAt])
  @@index([providerId, status])
}

// Vitesse réelle des pages vue par les téléphones (Core Web Vitals), sans donnée personnelle. 30 jours.
model WebVital {
  id         String   @id @default(cuid())
  page       String // modèle de page, ex. /r/[slug]
  name       String // LCP, FCP, TTFB, INP, CLS
  value      Float // millisecondes (CLS : sans unité)
  connection String? // 4g, 3g… si le navigateur le dit
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([name, page, createdAt])
}

// Parc de motos de Zedeka, prêtées aux livreurs salariés : le livreur en prend une libre quand il commence son
// service (ou l'équipe la lui attribue) et la rend en passant hors ligne. Sa plaque devient celle que voit le client.
model Motorbike {
  id         String           @id @default(cuid())
  plate      String           @unique
  label      String? // modèle, couleur
  note       String?
  photoKey   String?
  active     Boolean          @default(true) // false : au garage ou retirée, plus proposée
  driver     Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId   String?          @unique
  assignedAt DateTime?
  createdAt  DateTime         @default(now())
  shifts     MotorbikeShift[]
}

// Qui a eu quelle moto, de quand à quand. assignedBy : membre de l'équipe, ou null quand le livreur l'a prise lui-même.
model MotorbikeShift {
  id          String    @id @default(cuid())
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id], onDelete: Cascade)
  motorbikeId String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId    String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  assignedBy  String?

  @@index([motorbikeId, startedAt])
  @@index([driverId, startedAt])
}
