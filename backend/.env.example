DATABASE_URL="postgresql://zedeka:zedeka@localhost:5432/zedeka"
PORT=4000
# Origine du frontend autorisée (CORS)
FRONTEND_ORIGIN="http://localhost:3000"
# Numéro WhatsApp de Zedeka qui reçoit les commandes (format international, sans +)
ZEDEKA_WHATSAPP="22890000000"
# Espace admin : mot de passe du directeur des opérations (12 caractères minimum) et clé secrète des jetons
# (32 caractères minimum, ex. openssl rand -hex 32). En production, l'API refuse de démarrer avec ces exemples.
ADMIN_PASSWORD="changer-moi"
ADMIN_SECRET="une-longue-chaine-aleatoire"

# Derrière un proxy (nginx, Caddy…), nombre de proxys de confiance, pour que les limites par adresse IP
# voient la vraie adresse du client. Laisser vide si l'API est exposée directement.
TRUST_PROXY=""

# Dossier des fichiers envoyés (logos, documents des partenaires)
UPLOAD_DIR="uploads"

# Codes de connexion (clients, livreurs) et de mot de passe oublié : tant qu'aucun fournisseur SMS/WhatsApp
# n'est branché, OTP_DEV_CODES=true renvoie le code dans la réponse (affiché à l'écran). Développement uniquement :
# n'importe qui pourrait se connecter à n'importe quel compte. Ignoré et refusé en production (NODE_ENV=production).
OTP_DEV_CODES="true"

# Notifications Web Push (alarmes des partenaires). Générer avec : npx web-push generate-vapid-keys
# Sans ces variables, des clés sont créées au premier démarrage et gardées dans vapid.json.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:contact@zedeka.tg"
